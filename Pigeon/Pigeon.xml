<?xml version="1.0" encoding="UTF-8"?>
<Interface xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../Interface.xsd">
  <Windows>
    <!-- Every template name below (EA_Window_Default, EA_TitleBar_Default,
         EA_Button_DefaultWindowClose, EA_Window_DefaultBackgroundFrame,
         EA_EditBox_DefaultFrame, EA_Button_DefaultResizeable) is used by
         Warband Lead Helper's XML on this client. The attribute is "inherits". -->
    <Window name="PigeonWindow" inherits="EA_Window_Default" movable="true" savesettings="true">
      <Size>
        <AbsPoint x="520" y="430" />
      </Size>
      <Anchors>
        <Anchor point="center" relativePoint="center" relativeTo="Root">
          <AbsPoint x="0" y="0" />
        </Anchor>
      </Anchors>
      <Windows>
        <Window name="$parentTitleBar" inherits="EA_TitleBar_Default" />

        <Button name="$parentClose" inherits="EA_Button_DefaultWindowClose">
          <EventHandlers>
            <EventHandler event="OnLButtonUp" function="PigeonUI.OnCloseClicked" />
          </EventHandlers>
        </Button>

        <Window name="$parentBackground" inherits="EA_Window_DefaultBackgroundFrame" handleinput="true" popable="false">
          <Anchors>
            <Anchor point="topleft" relativePoint="topleft" relativeTo="$parent">
              <AbsPoint x="0" y="32" />
            </Anchor>
            <Anchor point="bottomright" relativePoint="bottomright" relativeTo="$parent" />
          </Anchors>
        </Window>

        <Label name="PigeonRoster" font="font_clear_medium_bold" textalign="left" wordwrap="true" maxchars="400">
          <Size>
            <AbsPoint x="200" y="40" />
          </Size>
          <Anchors>
            <Anchor point="topleft" relativePoint="topleft" relativeTo="$parent">
              <AbsPoint x="20" y="42" />
            </Anchor>
          </Anchors>
          <Color r="255" g="225" b="130" a="255" />
        </Label>

        <LogDisplay name="PigeonLog" font="font_chat_text" maxchars="2048">
          <Anchors>
            <Anchor point="topleft" relativePoint="topleft" relativeTo="$parent">
              <AbsPoint x="20" y="282" />
            </Anchor>
            <Anchor point="bottomright" relativePoint="bottomright" relativeTo="$parent">
              <AbsPoint x="-20" y="-20" />
            </Anchor>
          </Anchors>
          <EventHandlers>
            <EventHandler event="OnHyperLinkLButtonUp" function="PigeonUI.OnLink" />
          </EventHandlers>
        </LogDisplay>

        <Window name="PigeonGrip" handleinput="true" layer="popup">
          <Size>
            <AbsPoint x="18" y="18" />
          </Size>
          <Anchors>
            <Anchor point="bottomright" relativePoint="bottomright" relativeTo="$parent">
              <AbsPoint x="-6" y="-6" />
            </Anchor>
          </Anchors>
          <EventHandlers>
            <EventHandler event="OnLButtonDown" function="PigeonUI.GripDown" />
            <EventHandler event="OnLButtonUp" function="PigeonUI.GripUp" />
          </EventHandlers>
          <Windows>
            <FullResizeImage name="$parentBackground" inherits="EA_FullResizeImage_TintableSolidBackground" handleinput="false" layer="background">
              <Anchors>
                <Anchor point="topleft" relativePoint="topleft" relativeTo="$parent" />
                <Anchor point="bottomright" relativePoint="bottomright" relativeTo="$parent" />
              </Anchors>
            </FullResizeImage>
          </Windows>
        </Window>
      </Windows>
    </Window>

    <Window name="PigeonWaiting" inherits="EA_Window_Default" movable="true" savesettings="true">
      <Size>
        <AbsPoint x="270" y="290" />
      </Size>
      <Anchors>
        <Anchor point="topleft" relativePoint="topright" relativeTo="PigeonWindow">
          <AbsPoint x="4" y="0" />
        </Anchor>
      </Anchors>
      <Windows>
        <Window name="$parentTitleBar" inherits="EA_TitleBar_Default" />

        <Button name="$parentClose" inherits="EA_Button_DefaultWindowClose">
          <EventHandlers>
            <EventHandler event="OnLButtonUp" function="PigeonUI.OnWaitingClose" />
          </EventHandlers>
        </Button>

        <Window name="$parentBackground" inherits="EA_Window_DefaultBackgroundFrame" handleinput="true" popable="false">
          <Anchors>
            <Anchor point="topleft" relativePoint="topleft" relativeTo="$parent">
              <AbsPoint x="0" y="32" />
            </Anchor>
            <Anchor point="bottomright" relativePoint="bottomright" relativeTo="$parent" />
          </Anchors>
        </Window>

        <Label name="PigeonWaitingHint" font="font_clear_small" textalign="left" wordwrap="true" maxchars="200">
          <Size>
            <AbsPoint x="230" y="36" />
          </Size>
          <Anchors>
            <Anchor point="topleft" relativePoint="topleft" relativeTo="$parent">
              <AbsPoint x="20" y="42" />
            </Anchor>
          </Anchors>
          <Color r="255" g="225" b="130" a="255" />
        </Label>
      </Windows>
    </Window>

    <Window name="Pigeon_Wait_Template" layer="default" movable="false" popable="false" sticky="true" handleinput="true">
      <Size>
        <AbsPoint x="230" y="22" />
      </Size>
      <EventHandlers>
        <EventHandler event="OnLButtonUp" function="PigeonUI.OnWaitLMB" />
        <EventHandler event="OnRButtonUp" function="PigeonUI.OnWaitRMB" />
      </EventHandlers>
      <Windows>
        <FullResizeImage name="$parentBackground" inherits="EA_FullResizeImage_TintableSolidBackground" handleinput="true" layer="background">
          <Anchors>
            <Anchor point="topleft" relativePoint="topleft" relativeTo="$parent" />
            <Anchor point="bottomright" relativePoint="bottomright" relativeTo="$parent" />
          </Anchors>
        </FullResizeImage>
        <Label name="$parentName" font="font_clear_medium_bold" textalign="left" layer="overlay" popable="false" handleinput="false">
          <Size>
            <AbsPoint x="110" y="22" />
          </Size>
          <Anchors>
            <Anchor point="topleft" relativePoint="topleft" relativeTo="$parent">
              <AbsPoint x="6" y="2" />
            </Anchor>
          </Anchors>
          <Color r="255" g="225" b="120" />
        </Label>
        <Label name="$parentVia" font="font_clear_small" textalign="left" layer="overlay" popable="false" handleinput="false">
          <Size>
            <AbsPoint x="106" y="22" />
          </Size>
          <Anchors>
            <Anchor point="topleft" relativePoint="topleft" relativeTo="$parent">
              <AbsPoint x="118" y="4" />
            </Anchor>
          </Anchors>
          <Color r="200" g="200" b="200" />
        </Label>
      </Windows>
    </Window>

    <Window name="Pigeon_Row_Template" layer="default" movable="false" popable="false" sticky="true" handleinput="true">
      <Size>
        <AbsPoint x="480" y="22" />
      </Size>
      <EventHandlers>
        <EventHandler event="OnLButtonUp" function="PigeonUI.OnRowLMB" />
        <EventHandler event="OnRButtonUp" function="PigeonUI.OnRowRMB" />
      </EventHandlers>
      <Windows>
        <FullResizeImage name="$parentBackground" inherits="EA_FullResizeImage_TintableSolidBackground" handleinput="true" layer="background">
          <Anchors>
            <Anchor point="topleft" relativePoint="topleft" relativeTo="$parent" />
            <Anchor point="bottomright" relativePoint="bottomright" relativeTo="$parent" />
          </Anchors>
        </FullResizeImage>
        <Label name="$parentName" font="font_clear_medium_bold" textalign="left" layer="overlay" popable="false" handleinput="false">
          <Size>
            <AbsPoint x="104" y="22" />
          </Size>
          <Anchors>
            <Anchor point="topleft" relativePoint="topleft" relativeTo="$parent">
              <AbsPoint x="6" y="2" />
            </Anchor>
          </Anchors>
          <Color r="255" g="255" b="255" />
        </Label>
        <Label name="$parentText" font="font_clear_small" textalign="left" layer="overlay" popable="false" handleinput="false">
          <Size>
            <AbsPoint x="362" y="22" />
          </Size>
          <Anchors>
            <Anchor point="topleft" relativePoint="topleft" relativeTo="$parent">
              <AbsPoint x="112" y="4" />
            </Anchor>
            <Anchor point="topright" relativePoint="topright" relativeTo="$parent">
              <AbsPoint x="-52" y="4" />
            </Anchor>
          </Anchors>
          <Color r="255" g="255" b="255" />
        </Label>
        <Label name="$parentAge" font="font_clear_small" textalign="right" layer="overlay" popable="false" handleinput="false">
          <Size>
            <AbsPoint x="44" y="22" />
          </Size>
          <Anchors>
            <Anchor point="topright" relativePoint="topright" relativeTo="$parent">
              <AbsPoint x="-8" y="4" />
            </Anchor>
          </Anchors>
          <Color r="200" g="200" b="200" />
        </Label>
      </Windows>
    </Window>

    <Window name="Pigeon_Btn_Template" layer="default" movable="false" popable="false" sticky="true" handleinput="true">
      <EventHandlers>
        <EventHandler event="OnLButtonUp" function="PigeonBar.OnLMB" />
        <EventHandler event="OnRButtonUp" function="PigeonBar.OnRMB" />
      </EventHandlers>
      <Windows>
        <FullResizeImage name="$parentBackground" inherits="EA_FullResizeImage_TintableSolidBackground" handleinput="true" layer="background">
          <Anchors>
            <Anchor point="topleft" relativePoint="topleft" relativeTo="$parent" />
            <Anchor point="bottomright" relativePoint="bottomright" relativeTo="$parent" />
          </Anchors>
          <EventHandlers>
            <EventHandler event="OnMouseOver" function="PigeonBar.OnMouseOver" />
            <EventHandler event="OnMouseOverEnd" function="PigeonBar.OnMouseOut" />
          </EventHandlers>
        </FullResizeImage>
        <Label name="$parentLabel" font="font_clear_medium_bold" textalign="center" wordwrap="false" layer="overlay" popable="false" handleinput="false">
          <Size>
            <AbsPoint x="80" y="26" />
          </Size>
          <Anchors>
            <Anchor point="center" relativePoint="center" relativeTo="$parent">
              <AbsPoint x="0" y="0" />
            </Anchor>
          </Anchors>
          <Color r="255" g="255" b="255" />
        </Label>
      </Windows>
    </Window>
  </Windows>
</Interface>
